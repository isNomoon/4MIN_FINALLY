--- !u!114 &367889116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 367889114}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da2761303b2feb24ea3aace61be793d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  slides:
  - slideImage: {fileID: 21300000, guid: 9d71eec47cf9bf546b4204385f8e8ebb, type: 3}
    speakerName: 
    dialogueText: "\u5927\u5BB6\u597D\uFF0C\u6B22\u8FCE\u53C2\u52A0\u4ECA\u5929\u7684\u6821\u56ED\u6025\u6551\u57F9\u8BAD\u3002\n\u4ECA\u5929\u6211\u4EEC\u5B66\u4E60\u7684\u4E0D\u662F\u590D\u6742\u7684\u533B\u5B66\u77E5\u8BC6\uFF0C\u800C\u662F\u4E00\u9879\u6BCF\u4E2A\u4EBA\u90FD\u53EF\u80FD\u7528\u4E0A\u7684\u751F\u547D\u6280\u80FD\u3002"
  - slideImage: {fileID: 21300000, guid: a163c07020929a34890b594a51715910, type: 3}
    speakerName: 
    dialogueText: "\u60F3\u8C61\u4E00\u4E0B\uFF1A\n\u5982\u679C\u6709\u4E00\u5929\uFF0C\u4F60\u8EAB\u8FB9\u7684\u540C\u5B66\u7A81\u7136\u5012\u5730\uFF0C\u6CA1\u6709\u610F\u8BC6\uFF0C\u4E5F\u6CA1\u6709\u6B63\u5E38\u547C\u5438\u3002\n\u8FD9\u4E2A\u65F6\u5019\uFF0C\u7B2C\u4E00\u4E2A\u53D1\u73B0\u4ED6\u7684\u4EBA\uFF0C\u53EF\u80FD\u4E0D\u662F\u533B\u751F\uFF0C\u800C\u662F\u4F60\u3002"
  - slideImage: {fileID: 21300000, guid: 023f89c813ad1f74aa6ed37113b12239, type: 3}
    speakerName: 
    dialogueText: "\u90A3\u4E48\u95EE\u9898\u6765\u4E86\uFF1A\n\u9762\u5BF9\u8FD9\u6837\u7684\u60C5\u51B5\uFF0C\u6211\u4EEC\u5E94\u8BE5\u505A\u4EC0\u4E48\uFF1F\n\u5E94\u8BE5\u7B49\u5F85\u4E13\u4E1A\u4EBA\u5458\u5230\u8FBE\uFF1F\n\u8FD8\u662F\u4E3B\u52A8\u4F38\u51FA\u63F4\u624B\uFF1F\n\u4ECA\u5929\u7684\u8BFE\u7A0B\uFF0C\u5C31\u662F\u5E2E\u52A9\u5927\u5BB6\u627E\u5230\u7B54\u6848\u3002"
  - slideImage: {fileID: 21300000, guid: c88468a0a9aac0244abe3d7dd6726f7a, type: 3}
    speakerName: 
    dialogueText: "\u7ECF\u8FC7\u4ECA\u5929\u7684\u5B66\u4E60\uFF0C\u4F60\u9700\u8981\u638C\u63E1\u4E09\u9879\u6700\u91CD\u8981\u7684\u80FD\u529B\u3002"
  - slideImage: {fileID: 21300000, guid: c88468a0a9aac0244abe3d7dd6726f7a, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\uFF0C\u662F\u73B0\u573A\u5224\u65AD\u80FD\u529B\u3002\n\u770B\u5230\u6709\u4EBA\u5012\u5730\u65F6\uFF0C\u6211\u4EEC\u9700\u8981\u77E5\u9053\uFF1A\n\u73AF\u5883\u662F\u5426\u5B89\u5168\uFF1F\n\u60A3\u8005\u662F\u5426\u8FD8\u6709\u610F\u8BC6\uFF1F\n\u662F\u5426\u9700\u8981\u7ACB\u5373\u547C\u6551\uFF1F"
  - slideImage: {fileID: 21300000, guid: 04bf5717e31187946a9a89fe4cda668f, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\uFF0C\u662FCPR\u89C4\u8303\u64CD\u4F5C\u80FD\u529B\u3002\n\u5305\u62EC\uFF1A\n\u6B63\u786E\u7684\u4F4D\u7F6E\u3001\n\u6B63\u786E\u7684\u59FF\u52BF\u3001\n\u6B63\u786E\u7684\u6309\u538B\u8282\u594F\u3002"
  - slideImage: {fileID: 21300000, guid: 7106545c026b3aa4e9790260b523d1a5, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E09\uFF0C\u662FAED\u4F7F\u7528\u80FD\u529B\u3002\nAED\u5E76\u4E0D\u662F\u53EA\u6709\u533B\u751F\u624D\u80FD\u4F7F\u7528\u7684\u8BBE\u5907\u3002\n\u5B83\u5C31\u662F\u4E3A\u4E86\u5E2E\u52A9\u666E\u901A\u4EBA\u5728\u7D27\u6025\u60C5\u51B5\u4E0B\u5B8C\u6210\u6551\u63F4\u800C\u8BBE\u8BA1\u7684\u3002"
  - slideImage: {fileID: 21300000, guid: ec8f60ce0651f3d40b8068351cdbf1c4, type: 3}
    speakerName: 
    dialogueText: "\u5728\u5FC3\u810F\u9AA4\u505C\u53D1\u751F\u4E4B\u540E\uFF0C\u65F6\u95F4\u5C31\u662F\u751F\u547D\u3002\n\u6BCF\u8FC7\u53BB\u4E00\u5206\u949F\uFF0C\u60A3\u8005\u6210\u529F\u83B7\u6551\u7684\u673A\u4F1A\u90FD\u4F1A\u4E0B\u964D\u3002"
  - slideImage: {fileID: 21300000, guid: c7e93d35ac5a3d34f92779964a66d279, type: 3}
    speakerName: 
    dialogueText: "\u5F88\u591A\u65F6\u5019\uFF0C\u6551\u62A4\u8F66\u9700\u8981\u51E0\u5206\u949F\u751A\u81F3\u5341\u51E0\u5206\u949F\u624D\u80FD\u5230\u8FBE\u73B0\u573A\u3002\n\u800C\u8FD9\u6BB5\u7B49\u5F85\u65F6\u95F4\uFF0C\u5C31\u662F\u6700\u5173\u952E\u7684\u6551\u547D\u65F6\u95F4\u3002"
  - slideImage: {fileID: 21300000, guid: 9f480cfbaf12bcb4496ef311589e0654, type: 3}
    speakerName: 
    dialogueText: "\u6240\u4EE5\u73B0\u573A\u4EBA\u5458\u7684\u7B2C\u4E00\u53CD\u5E94\uFF0C\u975E\u5E38\u91CD\u8981\u3002\n\u4F60\u7684\u4E00\u4E2A\u52A8\u4F5C\uFF0C\n\u53EF\u80FD\u51B3\u5B9A\u4E00\u4E2A\u4EBA\u7684\u751F\u547D\u3002"
  - slideImage: {fileID: 21300000, guid: cb2135bb65047614092b77b83102efff, type: 3}
    speakerName: 
    dialogueText: "\u53D1\u73B0\u6709\u4EBA\u5012\u5730\uFF0C\u4E0D\u8981\u9A6C\u4E0A\u51B2\u8FC7\u53BB\u6309\u538B\u3002\n\u6B63\u786E\u6D41\u7A0B\u6709\u4E09\u4E2A\u6B65\u9AA4\u3002"
  - slideImage: {fileID: 21300000, guid: ddc8b94bd556f554fb7024ee9b01c6da, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\u6B65\uFF1A\n\u89C2\u5BDF\u73B0\u573A\u73AF\u5883\u3002\n\u786E\u8BA4\u5468\u56F4\u6709\u6CA1\u6709\u5371\u9669\u3002\n\u4F8B\u5982\uFF1A\n\u8F66\u8F86\u3001\u7535\u7EBF\u3001\u706B\u707E\u6216\u8005\u5176\u4ED6\u53EF\u80FD\u4F24\u5BB3\u4F60\u7684\u56E0\u7D20\u3002"
  - slideImage: {fileID: 21300000, guid: 93fe7c5406fcf9442953555d0b97c55d, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\u6B65\uFF1A\n\u5224\u65AD\u60A3\u8005\u6709\u6CA1\u6709\u610F\u8BC6\u3002\n\u6211\u4EEC\u53EF\u4EE5\u8F7B\u62CD\u60A3\u8005\u80A9\u8180\uFF0C\u5E76\u5927\u58F0\u547C\u558A\uFF1A\n\u201C\u4F60\u8FD8\u597D\u5417\uFF1F\u201D"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E09\u6B65\uFF1A\n\u89C2\u5BDF\u60A3\u8005\u662F\u5426\u6B63\u5E38\u547C\u5438\u3002\n\u5982\u679C\u60A3\u8005\u6CA1\u6709\u610F\u8BC6\uFF0C\u4E5F\u6CA1\u6709\u6B63\u5E38\u547C\u5438\uFF0C\n\u5C31\u9700\u8981\u7ACB\u5373\u542F\u52A8\u6025\u6551\u6D41\u7A0B\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u786E\u8BA4\u60A3\u8005\u6CA1\u6709\u53CD\u5E94\u548C\u6B63\u5E38\u547C\u5438\u540E\uFF0C\n\u4E0D\u8981\u4E00\u4E2A\u4EBA\u9ED8\u9ED8\u7B49\u5F85\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u6211\u4EEC\u9700\u8981\u7ACB\u5373\u547C\u6551\u3002\n\u4F46\u662F\u6CE8\u610F\uFF1A\n\u4E0D\u8981\u53EA\u558A\uFF1A\n\u201C\u6709\u6CA1\u6709\u4EBA\u5E2E\u5FD9\uFF1F\u201D"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u6B63\u786E\u7684\u65B9\u6CD5\u662F\u6307\u5B9A\u5177\u4F53\u7684\u4EBA\u3002\n\u4F8B\u5982\uFF1A\n\u201C\u7A7F\u9ED1\u8272\u8863\u670D\u7684\u540C\u5B66\uFF0C\u8BF7\u5E2E\u5FD9\u62E8\u6253120\u3002\u201D\n\u201C\u65C1\u8FB9\u7684\u540C\u5B66\uFF0C\u8BF7\u53BB\u5BFB\u627EAED\u3002\u201D"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u660E\u786E\u5206\u5DE5\uFF0C\u53EF\u4EE5\u907F\u514D\u6240\u6709\u4EBA\u7B49\u5F85\u522B\u4EBA\u884C\u52A8\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "CPR\uFF0C\u4E5F\u5C31\u662F\u5FC3\u80BA\u590D\u82CF\u3002 \u5B83\u662F\u4E00\u79CD\u901A\u8FC7\u4EBA\u5DE5\u65B9\u5F0F\u7EF4\u6301\u8840\u6DB2\u5FAA\u73AF\u7684\u65B9\u6CD5\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u5F53\u5FC3\u810F\u505C\u6B62\u8DF3\u52A8\u65F6\uFF0C \u5927\u8111\u548C\u8EAB\u4F53\u7684\u91CD\u8981\u5668\u5B98\u4F1A\u5FEB\u901F\u7F3A\u6C27\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u80F8\u5916\u6309\u538B\u7684\u76EE\u7684\uFF0C \u5C31\u662F\u5E2E\u52A9\u8840\u6DB2\u7EE7\u7EED\u6D41\u52A8\uFF0C
      \u4E3A\u7B49\u5F85\u4E13\u4E1A\u6551\u63F4\u4E89\u53D6\u65F6\u95F4\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u80F8\u5916\u6309\u538B\u6700\u91CD\u8981\u7684\u662F\u4F4D\u7F6E\u6B63\u786E\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u53CC\u624B\u638C\u6839\u653E\u5728\uFF1A \u4E24\u4E73\u5934\u8FDE\u7EBF\u4E2D\u70B9\uFF0C
      \u4E5F\u5C31\u662F\u80F8\u9AA8\u4E0B\u534A\u90E8\u5206\u7684\u4F4D\u7F6E\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u4E0D\u8981\u538B\u5728\u808B\u9AA8\u4F4D\u7F6E\uFF0C\n\u4E5F\u4E0D\u8981\u538B\u5728\u8179\u90E8\u3002\n\u9519\u8BEF\u7684\u4F4D\u7F6E\u4E0D\u4EC5\u6CA1\u6709\u6548\u679C\uFF0C\n\u8FD8\u53EF\u80FD\u9020\u6210\u4F24\u5BB3\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u627E\u5230\u4F4D\u7F6E\u4E4B\u540E\uFF0C \u4FDD\u6301\u6B63\u786E\u59FF\u52BF\u3002    
      \u53CC\u624B\u4EA4\u53E0\uFF0C \u624B\u81C2\u4FDD\u6301\u4F38\u76F4\uFF0C \u80A9\u8180\u5782\u76F4\u4F4D\u4E8E\u60A3\u8005\u80F8\u53E3\u4E0A\u65B9\u3002"
  - slideImage: {fileID: 21300000, guid: 473b47c32df622e44859ed58e5d50df3, type: 3}
    speakerName: 
    dialogueText: "\u5229\u7528\u8EAB\u4F53\u91CD\u91CF\u5411\u4E0B\u6309\u538B\uFF0C
      \u4E0D\u8981\u53EA\u4F7F\u7528\u624B\u81C2\u529B\u91CF\u3002 \u8FD9\u6837\u624D\u80FD\u4FDD\u8BC1\u6309\u538B\u6709\u6548\u3002"
  slideImageDisplay: {fileID: 796337892}
  nameText: {fileID: 0}
  contentText: {fileID: 750600035}
