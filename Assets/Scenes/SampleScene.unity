--- !u!114 &367889116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 367889114}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da2761303b2feb24ea3aace61be793d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gameObjects1:
  - {fileID: 618668518}
  - {fileID: 330585543}
  gameObjects2:
  - {fileID: 1838383351}
  - {fileID: 1383262877}
  - {fileID: 60008721}
  slides:
  - slideImage: {fileID: 21300000, guid: a290131dbe4b1f844ae3556ea7bb89b7, type: 3}
    speakerName: 
    dialogueText: "\u5927\u5BB6\u597D\uFF0C\u6B22\u8FCE\u53C2\u52A0\u4ECA\u5929\u7684\u6821\u56ED\u6025\u6551\u57F9\u8BAD\u3002\u4ECA\u5929\u6211\u4EEC\u5B66\u4E60\u7684\u4E0D\u662F\u590D\u6742\u7684\u533B\u5B66\u77E5\u8BC6\uFF0C\u800C\u662F\u4E00\u9879\u6BCF\u4E2A\u4EBA\u90FD\u53EF\u80FD\u7528\u4E0A\u7684\u751F\u547D\u6280\u80FD\u3002"
  - slideImage: {fileID: 21300000, guid: a290131dbe4b1f844ae3556ea7bb89b7, type: 3}
    speakerName: 
    dialogueText: "\u60F3\u8C61\u4E00\u4E0B\uFF1A\u5982\u679C\u6709\u4E00\u5929\uFF0C\u4F60\u8EAB\u8FB9\u7684\u540C\u5B66\u7A81\u7136\u5012\u5730\uFF0C\u6CA1\u6709\u610F\u8BC6\uFF0C\u4E5F\u6CA1\u6709\u6B63\u5E38\u547C\u5438\u3002\u8FD9\u4E2A\u65F6\u5019\uFF0C\u7B2C\u4E00\u4E2A\u53D1\u73B0\u4ED6\u7684\u4EBA\uFF0C\u53EF\u80FD\u4E0D\u662F\u533B\u751F\uFF0C\u800C\u662F\u4F60\u3002"
  - slideImage: {fileID: 21300000, guid: a290131dbe4b1f844ae3556ea7bb89b7, type: 3}
    speakerName: 
    dialogueText: "\u90A3\u4E48\u95EE\u9898\u6765\u4E86\uFF1A\u9762\u5BF9\u8FD9\u6837\u7684\u60C5\u51B5\uFF0C\u6211\u4EEC\u5E94\u8BE5\u505A\u4EC0\u4E48\uFF1F\u5E94\u8BE5\u7B49\u5F85\u4E13\u4E1A\u4EBA\u5458\u5230\u8FBE\uFF1F\u8FD8\u662F\u4E3B\u52A8\u4F38\u51FA\u63F4\u624B\uFF1F\u4ECA\u5929\u7684\u8BFE\u7A0B\uFF0C\u5C31\u662F\u5E2E\u52A9\u5927\u5BB6\u627E\u5230\u7B54\u6848\u3002"
  - slideImage: {fileID: 21300000, guid: b01341b80ed5ab34c8ce1826cc2e83f6, type: 3}
    speakerName: 
    dialogueText: "\u7ECF\u8FC7\u4ECA\u5929\u7684\u5B66\u4E60\uFF0C\u4F60\u9700\u8981\u638C\u63E1\u4E09\u9879\u6700\u91CD\u8981\u7684\u80FD\u529B\u3002"
  - slideImage: {fileID: 21300000, guid: b01341b80ed5ab34c8ce1826cc2e83f6, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\uFF0C\u662F\u73B0\u573A\u5224\u65AD\u80FD\u529B\u3002\u770B\u5230\u6709\u4EBA\u5012\u5730\u65F6\uFF0C\u6211\u4EEC\u9700\u8981\u77E5\u9053\uFF1A\u73AF\u5883\u662F\u5426\u5B89\u5168\uFF1F\u60A3\u8005\u662F\u5426\u8FD8\u6709\u610F\u8BC6\uFF1F\u662F\u5426\u9700\u8981\u7ACB\u5373\u547C\u6551\uFF1F"
  - slideImage: {fileID: 21300000, guid: b01341b80ed5ab34c8ce1826cc2e83f6, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\uFF0C\u662FCPR\u89C4\u8303\u64CD\u4F5C\u80FD\u529B\u3002\u5305\u62EC\uFF1A\u6B63\u786E\u7684\u4F4D\u7F6E\u3001\u6B63\u786E\u7684\u59FF\u52BF\u3001\u6B63\u786E\u7684\u6309\u538B\u8282\u594F\u3002"
  - slideImage: {fileID: 21300000, guid: b01341b80ed5ab34c8ce1826cc2e83f6, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E09\uFF0C\u662FAED\u4F7F\u7528\u80FD\u529B\u3002AED\u5E76\u4E0D\u662F\u53EA\u6709\u533B\u751F\u624D\u80FD\u4F7F\u7528\u7684\u8BBE\u5907\u3002\u5B83\u5C31\u662F\u4E3A\u4E86\u5E2E\u52A9\u666E\u901A\u4EBA\u5728\u7D27\u6025\u60C5\u51B5\u4E0B\u5B8C\u6210\u6551\u63F4\u800C\u8BBE\u8BA1\u7684\u3002"
  - slideImage: {fileID: 21300000, guid: 265a1e320ad88ab4a986ca812ee3ce28, type: 3}
    speakerName: 
    dialogueText: "\u5728\u5FC3\u810F\u9AA4\u505C\u53D1\u751F\u4E4B\u540E\uFF0C\u65F6\u95F4\u5C31\u662F\u751F\u547D\u3002\u6BCF\u8FC7\u53BB\u4E00\u5206\u949F\uFF0C\u60A3\u8005\u6210\u529F\u83B7\u6551\u7684\u673A\u4F1A\u90FD\u4F1A\u4E0B\u964D\u3002"
  - slideImage: {fileID: 21300000, guid: 265a1e320ad88ab4a986ca812ee3ce28, type: 3}
    speakerName: 
    dialogueText: "\u5F88\u591A\u65F6\u5019\uFF0C\u6551\u62A4\u8F66\u9700\u8981\u51E0\u5206\u949F\u751A\u81F3\u5341\u51E0\u5206\u949F\u624D\u80FD\u5230\u8FBE\u73B0\u573A\u3002\u800C\u8FD9\u6BB5\u7B49\u5F85\u65F6\u95F4\uFF0C\u5C31\u662F\u6700\u5173\u952E\u7684\u6551\u547D\u65F6\u95F4\u3002"
  - slideImage: {fileID: 21300000, guid: 265a1e320ad88ab4a986ca812ee3ce28, type: 3}
    speakerName: 
    dialogueText: "\u6240\u4EE5\u73B0\u573A\u4EBA\u5458\u7684\u7B2C\u4E00\u53CD\u5E94\uFF0C\u975E\u5E38\u91CD\u8981\u3002\u4F60\u7684\u4E00\u4E2A\u52A8\u4F5C\uFF0C\u53EF\u80FD\u51B3\u5B9A\u4E00\u4E2A\u4EBA\u7684\u751F\u547D\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u53D1\u73B0\u6709\u4EBA\u5012\u5730\uFF0C\u4E0D\u8981\u9A6C\u4E0A\u51B2\u8FC7\u53BB\u6309\u538B\u3002\u6B63\u786E\u6D41\u7A0B\u6709\u4E09\u4E2A\u6B65\u9AA4\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\u6B65\uFF1A\u89C2\u5BDF\u73B0\u573A\u73AF\u5883\u3002\u786E\u8BA4\u5468\u56F4\u6709\u6CA1\u6709\u5371\u9669\u3002\u4F8B\u5982\uFF1A\u8F66\u8F86\u3001\u7535\u7EBF\u3001\u706B\u707E\u6216\u8005\u5176\u4ED6\u53EF\u80FD\u4F24\u5BB3\u4F60\u7684\u56E0\u7D20\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\u6B65\uFF1A\u5224\u65AD\u60A3\u8005\u6709\u6CA1\u6709\u610F\u8BC6\u3002\u6211\u4EEC\u53EF\u4EE5\u8F7B\u62CD\u60A3\u8005\u80A9\u8180\uFF0C\u5E76\u5927\u58F0\u547C\u558A\uFF1A\u201C\u4F60\u8FD8\u597D\u5417\uFF1F\u201D"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E09\u6B65\uFF1A\u89C2\u5BDF\u60A3\u8005\u662F\u5426\u6B63\u5E38\u547C\u5438\u3002\u5982\u679C\u60A3\u8005\u6CA1\u6709\u610F\u8BC6\uFF0C\u4E5F\u6CA1\u6709\u6B63\u5E38\u547C\u5438\uFF0C\u5C31\u9700\u8981\u7ACB\u5373\u542F\u52A8\u6025\u6551\u6D41\u7A0B\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u786E\u8BA4\u60A3\u8005\u6CA1\u6709\u53CD\u5E94\u548C\u6B63\u5E38\u547C\u5438\u540E\uFF0C\u4E0D\u8981\u4E00\u4E2A\u4EBA\u9ED8\u9ED8\u7B49\u5F85\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u6211\u4EEC\u9700\u8981\u7ACB\u5373\u547C\u6551\u3002\u4F46\u662F\u6CE8\u610F\uFF1A\u4E0D\u8981\u53EA\u558A\uFF1A\u201C\u6709\u6CA1\u6709\u4EBA\u5E2E\u5FD9\uFF1F\u201D"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u6B63\u786E\u7684\u65B9\u6CD5\u662F\u6307\u5B9A\u5177\u4F53\u7684\u4EBA\u3002\u4F8B\u5982\uFF1A\u201C\u7A7F\u9ED1\u8272\u8863\u670D\u7684\u540C\u5B66\uFF0C\u8BF7\u5E2E\u5FD9\u62E8\u6253120\u3002\u201D\u201C\u65C1\u8FB9\u7684\u540C\u5B66\uFF0C\u8BF7\u53BB\u5BFB\u627EAED\u3002\u201D"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u660E\u786E\u5206\u5DE5\uFF0C\u53EF\u4EE5\u907F\u514D\u6240\u6709\u4EBA\u7B49\u5F85\u522B\u4EBA\u884C\u52A8\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "CPR\uFF0C\u4E5F\u5C31\u662F\u5FC3\u80BA\u590D\u82CF\u3002 \u5B83\u662F\u4E00\u79CD\u901A\u8FC7\u4EBA\u5DE5\u65B9\u5F0F\u7EF4\u6301\u8840\u6DB2\u5FAA\u73AF\u7684\u65B9\u6CD5\u3002"
  - slideImage: {fileID: 21300000, guid: 28231787de5751245b12ba96a986cf93, type: 3}
    speakerName: 
    dialogueText: "\u5F53\u5FC3\u810F\u505C\u6B62\u8DF3\u52A8\u65F6\uFF0C \u5927\u8111\u548C\u8EAB\u4F53\u7684\u91CD\u8981\u5668\u5B98\u4F1A\u5FEB\u901F\u7F3A\u6C27\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u80F8\u5916\u6309\u538B\u7684\u76EE\u7684\uFF0C \u5C31\u662F\u5E2E\u52A9\u8840\u6DB2\u7EE7\u7EED\u6D41\u52A8\uFF0C
      \u4E3A\u7B49\u5F85\u4E13\u4E1A\u6551\u63F4\u4E89\u53D6\u65F6\u95F4\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u80F8\u5916\u6309\u538B\u6700\u91CD\u8981\u7684\u662F\u4F4D\u7F6E\u6B63\u786E\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u53CC\u624B\u638C\u6839\u653E\u5728\uFF1A \u4E24\u4E73\u5934\u8FDE\u7EBF\u4E2D\u70B9\uFF0C
      \u4E5F\u5C31\u662F\u80F8\u9AA8\u4E0B\u534A\u90E8\u5206\u7684\u4F4D\u7F6E\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u4E0D\u8981\u538B\u5728\u808B\u9AA8\u4F4D\u7F6E\uFF0C\u4E5F\u4E0D\u8981\u538B\u5728\u8179\u90E8\u3002\u9519\u8BEF\u7684\u4F4D\u7F6E\u4E0D\u4EC5\u6CA1\u6709\u6548\u679C\uFF0C\u8FD8\u53EF\u80FD\u9020\u6210\u4F24\u5BB3\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u627E\u5230\u4F4D\u7F6E\u4E4B\u540E\uFF0C \u4FDD\u6301\u6B63\u786E\u59FF\u52BF.\u53CC\u624B\u4EA4\u53E0,\u624B\u81C2\u4FDD\u6301\u4F38\u76F4\uFF0C\u80A9\u8180\u5782\u76F4\u4F4D\u4E8E\u60A3\u8005\u80F8\u53E3\u4E0A\u65B9\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u5229\u7528\u8EAB\u4F53\u91CD\u91CF\u5411\u4E0B\u6309\u538B,\u4E0D\u8981\u53EA\u4F7F\u7528\u624B\u81C2\u529B\u91CF\u3002
      \u8FD9\u6837\u624D\u80FD\u4FDD\u8BC1\u6309\u538B\u6709\u6548\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u80F8\u5916\u6309\u538B\u9700\u8981\u4FDD\u6301\u7A33\u5B9A\u8282\u594F\u3002\u901F\u5EA6\u592A\u6162\uFF0C\u8840\u6DB2\u5FAA\u73AF\u4E0D\u8DB3\u3002\u901F\u5EA6\u592A\u5FEB\uFF0C\u80F8\u90E8\u65E0\u6CD5\u5145\u5206\u56DE\u5F39\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u6210\u4EBA\u6309\u538B\u9891\u7387\uFF1A\u6BCF\u5206\u949F\u5927\u7EA6100\u5230120\u6B21\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u6BCF\u6B21\u6309\u538B\u4E4B\u540E\uFF0C\u90FD\u8981\u8BA9\u80F8\u5ED3\u5B8C\u5168\u6062\u590D\u3002\u4E0D\u8981\u4E00\u76F4\u538B\u4F4F\u4E0D\u653E\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u5F88\u591A\u4EBA\u5728\u7B2C\u4E00\u6B21\u7EC3\u4E60CPR\u65F6\uFF0C\u5BB9\u6613\u51FA\u73B0\u4E24\u4E2A\u95EE\u9898\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\u4E2A\uFF1A\u6309\u538B\u4E4B\u540E\u6CA1\u6709\u5B8C\u5168\u677E\u5F00\u3002\u8FD9\u6837\u4F1A\u5F71\u54CD\u5FC3\u810F\u91CD\u65B0\u5145\u8840\u3002"
  - slideImage: {fileID: 21300000, guid: 12b3b7bff4e487f45ac92ece81c96e5f, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\u4E2A\uFF1A\u9891\u7E41\u505C\u6B62\u6309\u538B\u3002\u6025\u6551\u8FC7\u7A0B\u4E2D\uFF0C\u51CF\u5C11\u4E2D\u65AD\u65F6\u95F4\u975E\u5E38\u91CD\u8981\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u5F53\u5B8C\u621030\u6B21\u80F8\u5916\u6309\u538B\u4E4B\u540E\uFF0C\u5982\u679C\u65BD\u6551\u8005\u613F\u610F\u5E76\u4E14\u5177\u5907\u6761\u4EF6\uFF0C\u53EF\u4EE5\u8FDB\u884C\u4EBA\u5DE5\u547C\u5438\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u4EBA\u5DE5\u547C\u5438\u7684\u76EE\u7684\uFF0C\u662F\u5E2E\u52A9\u60A3\u8005\u8865\u5145\u6C27\u6C14\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u4EBA\u5DE5\u547C\u5438\u4E3B\u8981\u5206\u4E3A\u4E09\u4E2A\u6B65\u9AA4\uFF1A\u7B2C\u4E00\uFF0C\u5F00\u653E\u6C14\u9053\u3002\u7B2C\u4E8C\uFF0C\u634F\u4F4F\u9F3B\u7FFC\u3002\u7B2C\u4E09\uFF0C\u8FDB\u884C\u5439\u6C14\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u5F00\u653E\u6C14\u9053\u65F6\uFF0C\u4E00\u53EA\u624B\u538B\u4F4F\u60A3\u8005\u989D\u5934\uFF0C\u53E6\u4E00\u53EA\u624B\u62AC\u8D77\u4E0B\u5DF4\uFF0C\u8BA9\u6C14\u9053\u4FDD\u6301\u901A\u7545\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u5439\u6C14\u65F6\uFF0C\u4E0D\u8981\u7528\u529B\u8FC7\u731B\u3002\u770B\u5230\u60A3\u8005\u80F8\u53E3\u8F7B\u5FAE\u9686\u8D77\uFF0C\u8BF4\u660E\u6C14\u4F53\u5DF2\u7ECF\u8FDB\u5165\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u5F88\u591A\u540C\u5B66\u7B2C\u4E00\u6B21\u5B66\u4E60\u4EBA\u5DE5\u547C\u5438\u65F6\uFF0C\u90FD\u4F1A\u62C5\u5FC3\u536B\u751F\u95EE\u9898\u3002\u8FD9\u79CD\u62C5\u5FC3\u662F\u6B63\u5E38\u7684\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u5982\u679C\u4F60\u4E0D\u613F\u610F\u8FDB\u884C\u53E3\u5BF9\u53E3\u4EBA\u5DE5\u547C\u5438\uFF0C\u4E5F\u53EF\u4EE5\u9009\u62E9\u6301\u7EED\u8FDB\u884C\u80F8\u5916\u6309\u538B\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u4F46\u662F\u8BF7\u8BB0\u4F4F\uFF1A\u4E0D\u8981\u56E0\u4E3A\u5BB3\u6015\u4EBA\u5DE5\u547C\u5438\uFF0C\u800C\u505C\u6B62\u6240\u6709\u6551\u63F4\u884C\u52A8\u3002"
  - slideImage: {fileID: 21300000, guid: a0efe70a07d4ff645bb2ee663a9801be, type: 3}
    speakerName: 
    dialogueText: "\u5728\u771F\u5B9E\u6025\u6551\u73B0\u573A\uFF0C\u613F\u610F\u5F00\u59CB\u884C\u52A8\uFF0C\u6BD4\u7B49\u5F85\u5B8C\u7F8E\u7684\u65B9\u6CD5\u66F4\u52A0\u91CD\u8981\u3002"
  - slideImage: {fileID: 21300000, guid: 88f2bb1663450544bba097137184f612, type: 3}
    speakerName: 
    dialogueText: "\u5B8C\u6574\u7684CPR\u5FAA\u73AF\uFF0C\u5C31\u662F\uFF1A30\u6B21\u80F8\u5916\u6309\u538B\uFF0C\u52A0\u4E0A2\u6B21\u4EBA\u5DE5\u547C\u5438\u3002"
  - slideImage: {fileID: 21300000, guid: 88f2bb1663450544bba097137184f612, type: 3}
    speakerName: 
    dialogueText: "\u5B8C\u6210\u4E00\u6B21\u5FAA\u73AF\u540E\uFF0C\u7ACB\u5373\u7EE7\u7EED\u4E0B\u4E00\u8F6E\u6309\u538B\u3002\u4E0D\u8981\u56E0\u4E3A\u75B2\u52B3\u6216\u8005\u7D27\u5F20\uFF0C\u968F\u610F\u505C\u6B62\u3002"
  - slideImage: {fileID: 21300000, guid: 88f2bb1663450544bba097137184f612, type: 3}
    speakerName: 
    dialogueText: "\u5982\u679C\u73B0\u573A\u6709\u591A\u4EBA\uFF0C\u5E94\u8BE5\u4E92\u76F8\u914D\u5408\u3002\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u66F4\u6362\u6309\u538B\u4EBA\u5458\uFF0C\u4FDD\u8BC1\u6309\u538B\u8D28\u91CF\u3002"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u63A5\u4E0B\u6765\u6211\u4EEC\u5B66\u4E60\u4ECA\u5929\u975E\u5E38\u91CD\u8981\u7684\u8BBE\u5907\uFF1AAED\u3002AED\u7684\u4E2D\u6587\u540D\u79F0\u662F\uFF1A\u81EA\u52A8\u4F53\u5916\u9664\u98A4\u5668\u3002"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u5F88\u591A\u4EBA\u770B\u5230AED\uFF0C\u4F1A\u8BA4\u4E3A\uFF1A\u201C\u8FD9\u662F\u533B\u751F\u624D\u80FD\u4F7F\u7528\u7684\u8BBE\u5907\u3002\u201D"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u5B9E\u9645\u4E0A\uFF0C AED\u5C31\u662F\u4E3A\u666E\u901A\u516C\u4F17\u8BBE\u8BA1\u7684\u6025\u6551\u8BBE\u5907\u3002"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u5B83\u4F1A\u81EA\u52A8\u5206\u6790\u60A3\u8005\u5FC3\u5F8B\uFF0C\u5E76\u901A\u8FC7\u8BED\u97F3\u63D0\u793A\u6307\u5BFC\u64CD\u4F5C\u3002"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u5927\u5BB6\u6700\u62C5\u5FC3\u7684\u95EE\u9898\u901A\u5E38\u662F\uFF1A
      \u201C\u5982\u679C\u6211\u6309\u9519\u7535\u51FB\u6309\u94AE\u600E\u4E48\u529E\uFF1F\u201D"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u8FD9\u91CC\u5927\u5BB6\u53EF\u4EE5\u653E\u5FC3\u3002 AED\u4E0D\u4F1A\u968F\u610F\u653E\u7535\u3002"
  - slideImage: {fileID: 21300000, guid: 71cf3fbda29f3884a9151b6c30aac41f, type: 3}
    speakerName: 
    dialogueText: "\u53EA\u6709\u8BBE\u5907\u68C0\u6D4B\u5230\u9700\u8981\u9664\u98A4\u7684\u5FC3\u5F8B\uFF0C
      \u624D\u4F1A\u5141\u8BB8\u8FDB\u884C\u7535\u51FB\u3002\u5982\u679C\u4E0D\u9700\u8981\u7535\u51FB\uFF0C
      \u8BBE\u5907\u4E0D\u4F1A\u542F\u52A8\u653E\u7535\u6D41\u7A0B\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u6240\u4EE5\u4F7F\u7528AED\u65F6\uFF0C \u53EA\u9700\u8981\u6309\u7167\u8BED\u97F3\u63D0\u793A\u64CD\u4F5C\u5373\u53EF\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "AED\u4F7F\u7528\u975E\u5E38\u7B80\u5355\uFF0C \u4E3B\u8981\u5206\u4E3A\u56DB\u4E2A\u6B65\u9AA4\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\u6B65\uFF1A \u6253\u5F00AED\u8BBE\u5907\u3002\u4E0D\u540C\u578B\u53F7AED\u5916\u89C2\u53EF\u80FD\u4E0D\u540C\uFF0C
      \u4F46\u662F\u6253\u5F00\u8BBE\u5907\u540E\uFF0C \u90FD\u4F1A\u81EA\u52A8\u64AD\u653E\u8BED\u97F3\u6307\u5BFC\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u4ECE\u8FD9\u4E00\u523B\u5F00\u59CB\uFF0C \u4E0D\u8981\u7D27\u5F20\u3002
      \u6309\u7167\u8BBE\u5907\u63D0\u793A\u4E00\u6B65\u4E00\u6B65\u5B8C\u6210\u5373\u53EF\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\u6B65\uFF1A \u8D34\u4E0AAED\u7535\u6781\u7247\u3002\u9996\u5148\u9700\u8981\u6253\u5F00\u60A3\u8005\u80F8\u90E8\uFF0C
      \u786E\u4FDD\u76AE\u80A4\u88F8\u9732\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u4E24\u5F20\u7535\u6781\u7247\u5206\u522B\u8D34\u5728\uFF1A \u53F3\u4E0A\u80F8\u4F4D\u7F6E\uFF0C
      \u4EE5\u53CA\u5DE6\u4FA7\u80F8\u90E8\u4E0B\u65B9\u4F4D\u7F6E\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u8D34\u7247\u5FC5\u987B\u7D27\u8D34\u76AE\u80A4\uFF0C \u4E0D\u80FD\u9694\u7740\u8863\u670D\u3002\u5982\u679C\u80F8\u53E3\u6709\u6C34\uFF0C
      \u9700\u8981\u5148\u5FEB\u901F\u64E6\u5E72\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u7535\u6781\u7247\u8FDE\u63A5\u5B8C\u6210\u540E\uFF0C AED\u4F1A\u81EA\u52A8\u5F00\u59CB\u5206\u6790\u60A3\u8005\u5FC3\u5F8B\u3002\u8FD9\u65F6\u5019\u975E\u5E38\u91CD\u8981\uFF1A
      \u6240\u6709\u4EBA\u5FC5\u987B\u79BB\u5F00\u60A3\u8005\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u4E0D\u8981\u78B0\u60A3\u8005\uFF0C \u4E0D\u8981\u79FB\u52A8\u60A3\u8005\uFF0C
      \u7B49\u5F85AED\u5B8C\u6210\u5206\u6790\u3002\u56E0\u4E3A\u4EFB\u4F55\u63A5\u89E6\uFF0C
      \u90FD\u53EF\u80FD\u5F71\u54CD\u8BBE\u5907\u5224\u65AD\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u5982\u679CAED\u5224\u65AD\u9700\u8981\u9664\u98A4\uFF0C \u8BBE\u5907\u4F1A\u53D1\u51FA\u63D0\u793A\u3002\u5728\u6309\u4E0B\u7535\u51FB\u6309\u94AE\u4E4B\u524D\uFF0C
      \u4E00\u5B9A\u786E\u8BA4\uFF1A \u6240\u6709\u4EBA\u90FD\u5DF2\u7ECF\u79BB\u5F00\u60A3\u8005\u3002"
  - slideImage: {fileID: 21300000, guid: 3c02ba953060bb549a426ed10b88f61a, type: 3}
    speakerName: 
    dialogueText: "\u786E\u8BA4\u5B89\u5168\u540E\uFF0C \u6309\u4E0B\u95EA\u70C1\u7684\u7535\u51FB\u6309\u94AE\u3002\u7535\u51FB\u5B8C\u6210\u540E\uFF0C
      \u4E0D\u8981\u505C\u7559\u7B49\u5F85\u3002\u7ACB\u5373\u6062\u590D\u80F8\u5916\u6309\u538B\uFF0C
      \u7EE7\u7EEDCPR\u5FAA\u73AF\u3002"
  - slideImage: {fileID: 21300000, guid: 96fbbd319db3c26469bebcebdc3038d8, type: 3}
    speakerName: 
    dialogueText: "AED\u64CD\u4F5C\u770B\u4F3C\u7B80\u5355\uFF0C \u4F46\u662F\u4E00\u4E9B\u7EC6\u8282\u4F1A\u5F71\u54CD\u6551\u63F4\u6548\u679C\u3002"
  - slideImage: {fileID: 21300000, guid: 96fbbd319db3c26469bebcebdc3038d8, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E00\uFF1A AED\u5230\u8FBE\u540E\uFF0C \u4E0D\u8981\u505C\u6B62\u80F8\u5916\u6309\u538B\u7B49\u5F85\u8BBE\u5907\u3002\u6B63\u786E\u65B9\u5F0F\u662F\uFF1A
      \u4E00\u4E2A\u4EBA\u7EE7\u7EED\u6309\u538B\uFF0C \u53E6\u4E00\u4E2A\u4EBA\u8D1F\u8D23\u6253\u5F00AED\u548C\u8D34\u7247\u3002"
  - slideImage: {fileID: 21300000, guid: 96fbbd319db3c26469bebcebdc3038d8, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E8C\uFF1A \u5982\u679C\u60A3\u8005\u80F8\u6BDB\u8FC7\u591A\uFF0C
      \u5BFC\u81F4\u7535\u6781\u7247\u65E0\u6CD5\u7C98\u8D34\uFF0C \u9700\u8981\u5FEB\u901F\u5904\u7406\u3002"
  - slideImage: {fileID: 21300000, guid: 96fbbd319db3c26469bebcebdc3038d8, type: 3}
    speakerName: 
    dialogueText: "\u7B2C\u4E09\uFF1A \u5982\u679C\u60A3\u8005\u5904\u4E8E\u6F6E\u6E7F\u73AF\u5883\uFF0C
      \u5FC5\u987B\u5148\u79FB\u52A8\u5230\u5B89\u5168\u5E72\u71E5\u7684\u4F4D\u7F6E\u3002"
  - slideImage: {fileID: 21300000, guid: 96fbbd319db3c26469bebcebdc3038d8, type: 3}
    speakerName: 
    dialogueText: "AED\u64CD\u4F5C\u53EA\u9700\u8981\u8BB0\u4F4F\u56DB\u4E2A\u6B65\u9AA4\uFF1A
      \u6253\u5F00\u8BBE\u5907\u3001\u8FDE\u63A5\u7535\u6781\u7247\u3001\u5206\u6790\u5FC3\u5F8B\u3001\u6267\u884C\u9664\u98A4\u3002"
  - slideImage: {fileID: 21300000, guid: 96fbbd319db3c26469bebcebdc3038d8, type: 3}
    speakerName: 
    dialogueText: "\u6309\u7167\u8BBE\u5907\u63D0\u793A\u64CD\u4F5C\uFF0C\u5373\u4F7F\u6CA1\u6709\u533B\u5B66\u80CC\u666F\uFF0C\u4E5F\u53EF\u4EE5\u5B8C\u6210\u6025\u6551\u3002"
  - slideImage: {fileID: 21300000, guid: 54dbfd67fa362984fa649fbe2799a11a, type: 3}
    speakerName: 
    dialogueText: "\u6025\u6551\u8FC7\u7A0B\u4E2D\uFF0C\u6700\u5927\u7684\u9519\u8BEF\u4E0D\u662F\u64CD\u4F5C\u4E0D\u5B8C\u7F8E\uFF0C\u800C\u662F\u4E0D\u6562\u5F00\u59CB\u3002\u53D1\u73B0\u60C5\u51B5\u540E\uFF0C\u53CA\u65F6\u547C\u6551\u5E76\u5F00\u59CB\u6B63\u786E\u6551\u63F4\uFF0C\u624D\u662F\u6700\u91CD\u8981\u7684\u3002"
  - slideImage: {fileID: 21300000, guid: dd169bbecddb1824f89b0f5dfbc07fb4, type: 3}
    speakerName: 
    dialogueText: "\u5B8C\u6574\u7684\u6025\u6551\u6D41\u7A0B\u5305\u62EC\uFF1A \u5224\u65AD\u60C5\u51B5\u3001\u547C\u53EB\u5E2E\u52A9\u3001CPR\u3001AED\u9664\u98A4\u3002\u6BCF\u4E00\u6B65\u90FD\u5F88\u91CD\u8981\uFF0C\u4EFB\u4F55\u4E00\u4E2A\u73AF\u8282\u90FD\u53EF\u80FD\u5F71\u54CD\u6700\u7EC8\u7ED3\u679C\u3002"
  - slideImage: {fileID: 21300000, guid: dd169bbecddb1824f89b0f5dfbc07fb4, type: 3}
    speakerName: 
    dialogueText: "\u6025\u6551\u73B0\u573A\u6700\u91CD\u8981\u7684\u80FD\u529B\uFF0C\u662F\u4FDD\u6301\u51B7\u9759\u3002\u6B63\u786E\u5224\u65AD\u3001\u5FEB\u901F\u884C\u52A8\uFF0C\u6BD4\u614C\u4E71\u7B49\u5F85\u66F4\u52A0\u91CD\u8981\u3002"
  - slideImage: {fileID: 21300000, guid: 8b37e0f3ae8b0984b9d96f381b5a57bd, type: 3}
    speakerName: 
    dialogueText: "\u4ECA\u5929\u6211\u4EEC\u5B66\u4E60\u4E86CPR\u548CAED\u7684\u57FA\u672C\u77E5\u8BC6\u3002\u5E0C\u671B\u5927\u5BB6\u8BB0\u4F4F\uFF1A
      \u5173\u952E\u65F6\u523B\uFF0C\u6BCF\u4E2A\u4EBA\u90FD\u53EF\u4EE5\u6210\u4E3A\u751F\u547D\u5B88\u62A4\u8005\u3002"
  - slideImage: {fileID: 21300000, guid: 4567804cb2748164095bcad903bbe451, type: 3}
    speakerName: 
    dialogueText: "\u7406\u8BBA\u5B66\u4E60\u7ED3\u675F\uFF0C\u63A5\u4E0B\u6765\u8FDB\u5165\u5B9E\u9645\u64CD\u4F5C\u8BAD\u7EC3\u3002\u4F60\u9700\u8981\u4EB2\u81EA\u5B8C\u6210CPR\u548CAED\u64CD\u4F5C\u6D41\u7A0B\u3002\u8BF7\u6839\u636E\u63D0\u793A\u5B8C\u6210\u6BCF\u4E00\u6B65\uFF0C\u5E76\u63A5\u53D7\u6700\u7EC8\u8003\u6838\u3002"
  slideImageDisplay: {fileID: 796337892}
  nameText: {fileID: 0}
  contentText: {fileID: 750600035}
